 "title": "Zarządzenie Nr 20 Prezesa Rady Ministrów z dnia 10 marca 2009 r. w sprawie nadania statutu Ministerstwu Spraw Zagranicznych",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2009/181/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 20 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 10 marca 2009 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Spraw Zagranicznych"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Spraw Zagranicznych nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 84 Prezesa Rady Ministrów z dnia 28 lipca 2008 r. w sprawie nadania statutu Ministerstwu Spraw Zagranicznych (M. P. Nr 56, poz. 509).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
