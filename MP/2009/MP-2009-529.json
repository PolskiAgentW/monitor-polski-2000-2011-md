{
 "eli": "MP/2009/529",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 23 marca 2009 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2009/529/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 74/2009"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 23 marca 2009 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718, z 2002 r. Nr 74, poz. 676, z 2006 r. Nr 104, poz. 708 i 711 i Nr 194, poz. 1432 oraz z 2007 r. Nr 25, poz. 162 i Nr 123, poz. 848) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Gruszka Kazimierz Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Wiernicki Augustyn,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej, za osiągnięcia w działalności związkowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Rokosz Stanisław, 4. Sekuła Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Bogdan Stefan,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Serewko Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Brochocki Andrzej Stanisław, 8. Chromik Jerzy Krzysztof, 9. Czerski Jerzy Rafał, 10. Kryszczuk Krzysztof, 11. Somla Stefan Marek, 12. Zabłocki Jerzy Wacław, za zasługi w działalności społecznej i związkowej:",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Kamiński Henryk,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Waćkowski Sławomir,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Sportu i Turystyki"
    },
    {
     "type": "text",
     "text": "za zasługi na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Kaliciński Ryszard Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Środowiska"
    },
    {
     "type": "text",
     "text": "za zasługi na rzecz ochrony przyrody:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Kwiadas-Wierzbicka Ludwika, 17. Waśniewska Krystyna Marianna,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Piński Stanisław Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Zagranicznych"
    },
    {
     "type": "text",
     "text": "za zasługi w służbie dyplomatycznej, za działalność na rzecz organizacji polonijnych"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Truszkowski Ireneusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Krawczyk Bogumił.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: L. Kaczyński"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
