 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 9 lutego 2009 r. o nadaniu orderów",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2009/445/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 28/2009"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 9 lutego 2009 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej"
  },
  {
   "type": "text",
   "text": "Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia"
  },
  {
   "type": "text",
   "text": "16 października 1992 r. o orderach i odznaczeniach"
  },
  {
   "type": "text",
   "text": "(Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177,"
  },
  {
   "type": "text",
   "text": "z 2000 r. Nr 62, poz. 718, z 2002 r. Nr 74, poz. 676,"
  },
  {
   "type": "text",
   "text": "z 2006 r. Nr 104, poz. 708 i 711 i Nr 194, poz. 1432 oraz"
  },
  {
   "type": "text",
   "text": "z 2007 r. Nr 25, poz. 162 i Nr 123, poz. 848) odznaczeni"
  },
  {
   "type": "text",
   "text": "zostają KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI pośmiertnie"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla kultury polskiej, za osiągnięcia sportowe"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Bachleda-Curuś Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia sportowe, za zasługi dla rozwoju kultury fizycznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Bachleda-Curuś Jan Wojciech.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: L. Kaczyński"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
