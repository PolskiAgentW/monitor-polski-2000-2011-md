     "text": "za zasługi w działalności na rzecz ochrony przyrody i środowiska"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "86",
   "path": "ust_86",
   "text": "Chrobak Maria, 87. Szpytko Krzysztof Piotr,",
   "children": [
