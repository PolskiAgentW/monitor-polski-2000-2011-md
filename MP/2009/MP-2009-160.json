   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Andrzejewski Jan, 27. Augustowski Jarosław, 28. Bruczko Jan, 29. Buchowski Grzegorz, 30. Bućko Antoni, 31. Ciężkowski Dariusz, 32. Dymerski Józef, 33. Gaiński Tomasz, 34. Lepietuszko Sławomir, 35. Opryszczko Zenon, 36. Szotko Eugeniusz, 37. Zajkowski Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Tymiński Anatol Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Iskierski Jan, 40. Melon Jerzy, 41. Pruszak Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Dragan Krystyna, 43. Góralski Henryk, 44. Konczanin Bogusława, 45. Poltrok Józef Bronisław, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Daniluk Danuta Jadwiga, 47. Dargacz Tadeusz Mirosław, 48. Freiberg Gertruda, 49. Jakubowski Jan Bernard, 50. Krupińska Bogumiła Waleria, 51. Szwemin Tadeusz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "52",
   "path": "ust_52",
   "text": "Wójcik Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi na rzecz ochrony przyrody:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "53",
   "path": "ust_53",
   "text": "Szydlarski Marcin,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "54",
   "path": "ust_54",
   "text": "Kuczyńska Jadwiga Maria, 55. Zając Waldemar, 56. Zimny Zdzisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "57",
   "path": "ust_57",
   "text": "Jakubiec Krzysztof Eugeniusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "58",
   "path": "ust_58",
   "text": "Janic Dariusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju rzemiosła:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "59",
   "path": "ust_59",
   "text": "Hübscher Henryk,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "60",
   "path": "ust_60",
   "text": "Harnasz Aleksander Bogdan, 61. Kowalski Józef Bernard, 62. Kozielska Ingeborga, 63. Meisel Lucjan, 64. Mikos Stanisław, 65. Molitor Stanisław, 66. Muszer Bernard Antoni, 67. Rduch Jan, 68. Szymiczek Andrzej, 69. Worek Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności związkowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "70",
   "path": "ust_70",
   "text": "Herwy Grzegorz Edward,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "71",
   "path": "ust_71",
   "text": "Trzcionka Dariusz Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "72",
   "path": "ust_72",
