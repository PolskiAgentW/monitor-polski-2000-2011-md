   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "73",
   "path": "ust_73",
   "text": "Gładki Zbigniew Marian, 74. Siekanka Adam, na wniosek Wojewody Warmińsko-Mazurskiego:",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "75",
   "path": "ust_75",
   "text": "Kołakowski Marek Janusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "76",
   "path": "ust_76",
   "text": "Prościo Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej, za działalność charytatywną"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "77",
   "path": "ust_77",
   "text": "Bugajny Paweł Krzysztof, 78. Desko Tomasz, 79. Maciński Piotr, 80. Majchrzycki Wojciech Tadeusz, 81. Michańków Adam Maciej, 82. Müllauer Witold Jakub, 83. Nickel Marian Krzysztof, 84. Paszyn Jarosław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "85",
