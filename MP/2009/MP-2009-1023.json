     "type": "text",
     "text": "STATUT MINISTERSTWA SPRAW ZAGRANICZNYCH"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Spraw Zagranicznych, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Spraw Zagranicznych właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 22 grudnia 2009 r. w sprawie szczegółowego zakresu działania Ministra Spraw Zagranicznych (Dz. U. Nr 220, poz. 1725), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "zagranicznych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "członkostwa Rzeczypospolitej Polskiej w Unii Europejskiej.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
