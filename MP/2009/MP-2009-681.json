 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 50 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 13 lipca 2009 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Pracy i Polityki Społecznej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Pracy i Polityki Społecznej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 117 Prezesa Rady Ministrów z dnia 22 października 2007 r. w sprawie nadania statutu Ministerstwu Pracy i Polityki Społecznej (M. P. Nr 78, poz. 838 oraz z 2009 r. Nr 14, poz. 180).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
