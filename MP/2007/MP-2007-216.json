 "title": "Zarządzenie Nr 26 Prezesa Rady Ministrów z dnia 14 marca 2007 r. w sprawie nadania statutu Ministerstwu Spraw Wewnętrznych i Administracji",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2007/216/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 26 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 14 marca 2007 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Spraw Wewnętrznych i Administracji"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Spraw Wewnętrznych i Administracji nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 13 Prezesa Rady Ministrów z dnia 23 stycznia 2006 r. w sprawie nadania statutu Ministerstwu Spraw Wewnętrznych i Administracji (M. P. Nr 6, poz. 97, Nr 43, poz. 462 i Nr 54, poz. 577 oraz z 2007 r. Nr 2, poz. 15).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Kaczyński"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 26 Prezesa Rady Ministrów z dnia 14 marca 2007 r. (poz. 216)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA SPRAW WEWNĘTRZNYCH I ADMINISTRACJI"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Spraw Wewnętrznych i Administracji, zwane dalej „ministerstwem”, zapewnia obsługę Ministra Spraw Wewnętrznych i Administracji właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 18 lipca 2006 r. w sprawie szczegółowego zakresu działania Ministra Spraw Wewnętrznych i Administracji (Dz. U. Nr 131, poz. 919 oraz z 2007 r. Nr 38, poz. 245), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "administracji publicznej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "informatyzacji;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "wewnętrznych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/pkt_4",
       "text": "wyznań religijnych oraz mniejszości narodowych i etnicznych.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
