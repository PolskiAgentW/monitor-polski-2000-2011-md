   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Filipowski Feliks, 10. Kmita Leon, 11. Lewandowski Adam Franciszek, 12. Snochowski Władysław, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
