    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Bartoszczyk Józef, 16. Chłodny Józef, 17. Jaskuła Włodzimierz, 18. Zawadzki Stanisław,",
