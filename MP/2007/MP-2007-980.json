 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2007/980/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 136 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 29 listopada 2007 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Infrastruktury"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Infrastruktury nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 136 Prezesa Rady Ministrów z dnia 29 listopada 2007 r. (poz. 980)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA INFRASTRUKTURY"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Infrastruktury, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Infrastruktury, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 16 listopada 2007 r. w sprawie szczegółowego zakresu działania Ministra Infrastruktury (Dz. U. Nr 216, poz. 1594), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "budownictwo, gospodarka przestrzenna i mieszkaniowa;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "gospodarka morska;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "łączność;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/pkt_4",
       "text": "transport.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
