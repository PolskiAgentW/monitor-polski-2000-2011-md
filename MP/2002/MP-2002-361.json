{
 "eli": "MP/2002/361",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 28 marca 2002 r. o nadaniu orderów i odznaczenia.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2002/361/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 56/2002 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 28 marca 2002 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177 i z 2000 r. Nr 62, poz. 718) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju gospodarki narodowej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Heidrich Karol Edward,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Denczew Sławczo,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz organizacji kombatanckich:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Dawid Stanisław Ludwik, 4. Glensk Zygmunt, 5. Radiukiewicz Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Czerwiński Józef Wincenty, 7. Dorosiewicz Jan,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Kozłowski Kazimierz, 9. Skowrońska Danuta, 10. Sobczak Andrzej Stefan, 11. Sordyl Janina,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla polskiej ceramiki"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Wosiek Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy naukowej i dydaktycznej, za osiągnięcia w działalności społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Bialik Włodzimierz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pracy dydaktycznej, za osiągnięcia w działalności społecznej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Jankowiak Piotr.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
