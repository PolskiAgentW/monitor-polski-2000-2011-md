{
 "eli": "MP/2002/860",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 23 września 2002 r. o nadaniu odznaczeń.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2002/860/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 213/2002 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 23 września 2002 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r."
  },
  {
   "type": "text",
   "text": "o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Wojewody Lubuskiego"
  },
  {
   "type": "text",
   "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej, za działalność społeczną:"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Dajczak Kazimierz, 2. Dul Józef, 3. Kolas Jadwiga, 4. Spiralska Alina, 5. Szuster Iwona Józefa, 6. Żelechowska Zofia Bernadeta,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Ahmed Mahmod Aldona,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi dla rozwoju kultury, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Głybin Jerzy, 9. Tarczyński Czesław Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi dla ochrony środowiska"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Grzybek Jacek Józef,",
   "children": [
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Kaczmarek Tadeusz Ryszard, 12. Kaźmierczak Ryszard, za zasługi dla rozwoju sportu:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Koterba Jerzy Jan, 14. Marcinkowski Marian Andrzej, 15. Niewitecki Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Gruszczyński Cezary Andrzej, 17. Urbańczyk Elżbieta Maria,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Matczak Andrzej, za zasługi w działalności na rzecz społeczności lokalnej",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Jaskuła Barbara Helena, 20. Szymankiewicz Józef,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w produkcji rolnej, za działalność społeczną:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Łysiak Tadeusz, 22. Musieł Piotr Paweł, 23. Zawiślak Damazy,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Konieczny Jerzy Stanisław, 25. Witek Tadeusz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
