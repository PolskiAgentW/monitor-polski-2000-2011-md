{
 "eli": "MP/2002/199",
 "title": "Zarządzenie Nr 30 Prezesa Rady Ministrów z dnia 13 marca 2002 r. w sprawie nadania statutu Ministerstwu Sprawiedliwości.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2002/199/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 30 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 13 marca 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Sprawiedliwości."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 1999 r. Nr 82, poz. 929, z 2000 r. Nr 120, poz. 1268 oraz z 2001 r. Nr 102, poz. 1116 i Nr 154, poz. 1799 i 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Sprawiedliwości nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 30 Prezesa Rady Ministrów z dnia 13 marca 2002 r. (poz. 199)",
