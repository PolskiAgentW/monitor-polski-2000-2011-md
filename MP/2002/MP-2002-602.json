{
 "eli": "MP/2002/602",
 "title": "Zarządzenie Nr 102 Prezesa Rady Ministrów z dnia 30 sierpnia 2002 r. zmieniające zarządzenie w sprawie nadania statutu Ministerstwu Finansów.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2002/602/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 102 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 30 sierpnia 2002 r."
  },
  {
   "type": "text",
   "text": "zmieniające zarządzenie w sprawie nadania statutu Ministerstwu Finansów."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 1999 r. Nr 82, poz. 929, z 2000 r. Nr 120, poz. 1268 oraz z 2001 r. Nr 102, poz. 1116 i Nr 154, poz. 1799 i 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W zarządzeniu nr 22 Prezesa Rady Ministrów z dnia 13 lutego 2002 r. w sprawie nadania statutu Ministerstwu Finansów (M. P. Nr 8, poz. 150 i Nr 15, poz. 248) w załączniku wprowadza się następujące zmiany:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "w § 2:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "po pkt 16 dodaje się pkt 16a w brzmieniu:",
       "children": [
        {
         "type": "text",
         "text": "„16a) Departament Podatku Akcyzowego,”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "po pkt 24 dodaje się pkt 24a w brzmieniu:",
       "children": [
        {
         "type": "text",
         "text": "„24a) Biuro Międzynarodowych Relacji Skarbowych,”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "pkt 33 otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„33) Biuro Audytu Wewnętrznego,”;",
         "quoted": true
        }
       ]
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "w § 3 pkt 2 otrzymuje brzmienie:",
     "children": [
      {
       "type": "text",
       "text": "„2) w zakresie działu finanse publiczne:",
       "quoted": true
      },
      {
       "type": "text",
       "text": "a) Departament Kontroli Skarbowej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "b) Biuro Międzynarodowych Relacji Skarbowych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "c) Departament Ceł,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "d) Departament Organizacji Służby Celnej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "e) Departament Kontroli Celnej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "f) Departament Gier Losowych i Zakładów Wzajemnych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "g) Departament Podatków Pośrednich,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "h) Departament Podatku Akcyzowego,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "i) Departament Podatków Bezpośrednich,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "j) Departament Systemu Podatkowego,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "k) Departament Podatków Lokalnych i Katastru,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "l) Departament Obsługi Funduszy Pomocowych,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "m) Departament Koordynacji Kontroli Finansowej i Audytu Wewnętrznego,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "n) Departament Polityki Zagranicznej,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "o) Departament Organizacji Skarbowości,",
       "quoted": true
      },
      {
       "type": "text",
       "text": "p) Biuro Dokumentacji Skarbowej,”.",
       "quoted": true
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
