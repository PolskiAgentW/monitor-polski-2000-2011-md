   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA SPRAW WEWNĘTRZNYCH I ADMINISTRACJI"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Spraw Wewnętrznych i Administracji, zwane dalej „ministerstwem”, zapewnia obsługę Ministra Spraw Wewnętrznych i Administracji właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 14 marca 2002 r. w sprawie szczegółowego zakresu działania Ministra Spraw Wewnętrznych i Administracji (Dz. U. Nr 35, poz. 325 i Nr 58, poz. 533), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "administracji publicznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "wewnętrznych,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "wyznań religijnych.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
