 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 2 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 4 stycznia 2002 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Obrony Narodowej."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 10 ust. 2 ustawy z dnia 14 grudnia 1995 r. o urzędzie Ministra Obrony Narodowej (Dz. U. z 1996 r. Nr 10, poz. 56 i Nr 102, poz. 474, z 1997 r. Nr 121, poz. 770 i Nr 141, poz. 944, z 1999 r. Nr 11, poz. 95 oraz z 2001 r. Nr 123, poz. 1353 i Nr 154, poz. 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Obrony Narodowej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [
