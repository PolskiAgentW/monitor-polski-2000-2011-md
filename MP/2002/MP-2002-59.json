     "type": "text",
     "text": "STATUT MINISTERSTWA INFRASTRUKTURY"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Infrastruktury, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Infrastruktury, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 20 października 2001 r. w sprawie szczegółowego zakresu działania Ministra Infrastruktury (Dz. U. Nr 122, poz. 1336 i Nr 154, poz. 1809), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "budownictwa, gospodarki przestrzennej i mieszkaniowej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "gospodarki morskiej,",
       "children": []
