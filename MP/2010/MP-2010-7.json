{
 "eli": "MP/2010/7",
 "title": "Zarządzenie Nr 3 Prezesa Rady Ministrów z dnia 8 stycznia 2010 r. w sprawie nadania statutu Ministerstwu Skarbu Państwa",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2010/7/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 3 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 8 stycznia 2010 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Skarbu Państwa"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Skarbu Państwa nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 29 Prezesa Rady Ministrów z dnia 18 marca 2008 r. w sprawie nadania statutu Ministerstwu Skarbu Państwa (M. P. Nr 24, poz. 238 oraz z 2009 r. Nr 9, poz. 98).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem 11 stycznia 2010 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
