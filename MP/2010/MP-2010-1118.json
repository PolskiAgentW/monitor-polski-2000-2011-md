   "num": "1",
   "path": "ust_1",
   "text": "Krzysztof Zygmunt EICHSTAEDT — w Łodzi",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Wiesław Marian KOSOWSKI — w Katowicach",
   "children": [
