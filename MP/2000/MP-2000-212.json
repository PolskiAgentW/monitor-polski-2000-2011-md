{
 "eli": "MP/2000/212",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 4 stycznia 2000 r. o nadaniu orderów i odznaczeń.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2000/212/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 3/2000"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 4 stycznia 2000 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450 i z 1999 r. Nr 101, poz. 1177) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju bankowości:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kalinowski Wiesław s. Ryszarda,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Kuzyk Zofia c. Jana,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju bankowości"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Golec Maria c. Bolesława,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w pracy artystycznej i publicystycznej, za zasługi dla rozwoju kultury"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Terpiłowski Michał Lech s. Zygmunta,",
   "children": [
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Skrzypczak Regina c. Michała, za zasługi dla rozwoju spółdzielczości mieszkaniowej:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kędzia Mirosław s. Leona,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Dremza Krzysztof s. Henryka,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Cichomski Mieczysław s. Franciszka, 9. Januszkiewicz Maciej s. Jana, 10. Lorent Grażyna c. Kazimierza, 11. Paszkowski Józef s. Tadeusza, 12. Szymańska Sabina c. Teofila,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz organizacji kombatanckiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Bartosik Tadeusz s. Zygmunta,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Ukrainy"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju polskiej kinematografii, za osiągnięcia w pracy artystycznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Stupka Bogdan.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
