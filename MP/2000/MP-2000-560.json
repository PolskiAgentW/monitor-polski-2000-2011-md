{
 "eli": "MP/2000/560",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 5 czerwca 2000 r. o nadaniu orderów i odznaczenia.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2000/560/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 128/2000"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 5 czerwca 2000 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450 i z 1999 r. Nr 101, poz. 1177) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności społecznej na rzecz emerytów, rencistów i osób niepełnosprawnych:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Młodawski Jerzy s. Franciszka,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Lisowski Henryk s. Filipa,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Piotrowski Henryk s. Antoniego, za zasługi w działalności społecznej na rzecz emerytów, rencistów i osób niepełnosprawnych",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kowalczyk Anna c. Jana,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju ruchu kobiecego, za działalność na rzecz integracji Polski z Unią Europejską"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Śliwińska Agnieszka c. Wiesława.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
