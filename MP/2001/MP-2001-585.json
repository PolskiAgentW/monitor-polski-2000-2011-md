   "type": "text",
   "text": "UCHWAŁA SEJMU RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 19 października 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie wyboru wicemarszałków Sejmu."
  },
  {
   "type": "text",
   "text": "Sejm Rzeczypospolitej Polskiej, na podstawie art. 110 ust. 1 Konstytucji Rzeczypospolitej Polskiej, dokonuje wyboru posłów:"
  },
  {
   "type": "text",
   "text": "— Andrzeja LEPPERA"
  },
  {
   "type": "text",
   "text": "— Tomasza NAŁĘCZA — Donalda TUSKA"
  },
  {
   "type": "text",
   "text": "— Janusza WOJCIECHOWSKIEGO"
  },
  {
   "type": "text",
   "text": "na stanowiska wicemarszałków Sejmu."
  },
  {
   "type": "signature",
   "text": "Marszałek Sejmu: M. Borowski"
  }
 ],
