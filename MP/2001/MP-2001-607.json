{
 "eli": "MP/2001/607",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 20 lipca 2001 r. o nadaniu odznaczeń.",
 "converter": "eli2md 0.6.64",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2001/607/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 147/2001"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 20 lipca 2001 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177 i z 2000 r. Nr 62, poz. 718) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Wojewody Kujawsko-Pomorskiego:"
  },
  {
   "type": "text",
   "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Gładkowski Roman Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Gawliński Waldemar, 3. Gorzycka Maria, 4. Krygier Marek Waldemar, 5. Powielajew Marek Stanisław, 6. Sobański Piotr,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Zieliński Stanisław Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Monowid Zbigniew Ludwik,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Horbacz Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Barańczak Jarosław Marian, 11. Dobek-Dryjańska Władysława Kamilla, 12. Lipnicki Zygmunt, 13. ks. Nowaczyk Jerzy Sławomir, 14. Zabagło Marian,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Gradowicz Grażyna Maria, 16. Smykał Anna Krystyna,",
   "children": [
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Bałkowski Antoni, 18. Koniecki Stanisław Zbigniew, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Władysiak Bronisław Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego:"
    },
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej oraz zasługi w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Januszewski Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Owczarek Teresa Balbina,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Paździej Jadwiga Teodora, 23. Sobala Benedykt, 24. Suchorska Mirosława, 25. Szczepanik Józef Marian, 26. Wlazłowski Tomasz, 27. Zalepa Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Cabaj Waldemar Bogdan, 29. Obiedziński Henryk,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Dziekański Antoni Leszek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Żylis Zygmunt,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Opolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w pracy zawodowej, za działalność na rzecz przemian demokratycznych w Polsce:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Grzeliński Adam Zdzisław, 33. Ziobrowska Krystyna Irena,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Lech Marian Franciszek, 35. Sołek Ireneusz Józef, 36. Stelmach Marek, 37. Żuraw Edward, na wniosek Wojewody Podkarpackiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz Stowarzyszenia Przyjaciół Iwonicza-Zdroju:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Nycz Adam Jan, 39. Nycz Jan Marian,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "Włodarczyk Mariusz Antoni,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej w Stowarzyszeniu Rodzin Ziemi Wołkowyskiej w Gdańsku"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Popieliński Edmund,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Andruszkiewicz Józef, 43. Nawrocki Wacław,",
   "children": [
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Nowopolski Bogusław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Gierszewski Piotr, 46. Nosek Roman, 47. Wiśniewski Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju samorządu gospodarczego, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Wegner Helena, na wniosek Wojewody Świętokrzyskiego:",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Bąk Adam Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi i zaangażowanie w działalność na rzecz Stowarzyszenia Ochrony Dziedzictwa Narodowego w Kielcach"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "50",
   "path": "ust_50",
   "text": "Dłużewski Henryk, 51. Kępkowska Urszula,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "52",
   "path": "ust_52",
   "text": "Adamczyk Mieczysław Stanisław, 53. Cecelon Jan, 54. Tałaj Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju sportu samochodowego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "55",
   "path": "ust_55",
   "text": "Bogusz Marian Bolesław, 56. Chwiralski Ludwik Jerzy, 57. Zajfert Paweł Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "58",
   "path": "ust_58",
   "text": "Kokocińska Bożena Barbara, 59. Majchrzak Jerzy, 60. Piwoński Stanisław.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
