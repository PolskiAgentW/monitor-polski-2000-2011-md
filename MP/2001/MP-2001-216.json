{
 "eli": "MP/2001/216",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 27 lutego 2001 r. o nadaniu orderów i odznaczeń.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2001/216/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 30/2001"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 27 lutego 2001 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177 i z 2000 r. Nr 62, poz. 718) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w pracy naukowo-dydaktycznej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Brożyniak Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "w uznaniu wybitnych zasług w długoletniej pracy zawodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Rurka Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy samorządowej, za działalność społeczną:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Siłka Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Szatan Bronisław Wojciech, 5. Szatkowski Stanisław Lech, za zasługi w pracy samorządowej, za działalność społeczną",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Sycz Miron,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz organizacji kombatanckich"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Baczewska-Jarmolińska Grażyna, 8. Dziądziak Zygmunt, 9. płk Wrona Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla ochrony zdrowia, za działalność na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Kępka Aleksander Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Adamczyk Edward Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Piór Maria Jolanta.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
