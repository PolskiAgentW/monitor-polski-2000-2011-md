{
 "eli": "MP/2001/41",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 14 listopada 2000 r. o nadaniu odznaczeń.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2001/41/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 265/2000"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 14 listopada 2000 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177 i z 2000 r. Nr 62, poz. 718) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Wojewody Lubelskiego"
  },
  {
   "type": "text",
   "text": "za zasługi w pracy artystycznej:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Gierej Grażyna,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Saulska Bożenna, 3. Szydłowska Krystyna Maria, 4. Turowicz Jerzy Wojciech, 5. Wlizło Janusz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kamińska Beata,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz Fundacji im. Brata Alberta"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Dyrda Stanisław Edward, 8. Gołda Leszek Włodzimierz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Boruch Edward, na wniosek Wojewody Pomorskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz spółdzielczości mieszkaniowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Purzycki Henryk Zenon,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego:"
    },
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej oraz zasługi w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Mierzyński Janusz Ludwik,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Adamus Walenty Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "ks. Kaziorski Daniel Bogdan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji:"
    },
    {
     "type": "text",
     "text": "za wykazane męstwo i odwagę w ratowaniu życia ludzkiego:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ po raz drugi"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Krygier Jan, KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ",
   "children": []
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Kiwiński Jan, 16. Królik Kazimierz, 17. Kudła Zenon, za zasługi w ratowaniu życia ludzkiego",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Królik Edward.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
