{
 "eli": "MP/2001/318",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 12 kwietnia 2001 r. o nadaniu orderów i odznaczeń.",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2001/318/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 65/2001 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 12 kwietnia 2001 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177 i z 2000 r. Nr 62, poz. 718) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w pracy dziennikarskiej i działalności wydawniczej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Cieśliński Zbigniew Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Pilarski Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kiedrowski Janusz Roman, 4. Stachowski Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Zakryś Leon,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Bonk Feliks Aleksander, 7. Rytlewski Kazimierz, 8. Ziegert Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pracy artystycznej oraz działalności społecznej i charytatywnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Drążek Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz Toruńskiego Towarzystwa Kultury"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Rosiak Marek Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz Stowarzyszenia Słowiańskiej Mniejszości Narodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Grygorowicz Aleksander, 12. Zin Władysław, KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI",
   "children": []
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Czerwacki Eugeniusz, 14. Ignatiuk Jerzy, 15. ks. Kaczan Jan, 16. Nikitorowicz Aleksander, 17. Pachwicewicz Raisa, 18. Rusaczyk Tamara, 19. Siemieniuk Eugeniusz, 20. Smyk Jan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz ochrony środowiska"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Morkowski Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony środowiska:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Gołdyka Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Małek Urszula, 24. Pędziwiatr Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy artystycznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Jakubowska-Drzewiecka Teresa,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Wielkiej Brytanii"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "mjr Keast Francis.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
