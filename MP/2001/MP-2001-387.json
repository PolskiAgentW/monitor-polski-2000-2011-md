    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "53",
   "path": "ust_53",
   "text": "Rosiak Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju hodowli i produkcji zwierzęcej, za osiągnięcia w pracy naukowo-dydaktycznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "54",
   "path": "ust_54",
   "text": "Rak Bronisław Jan, 55. Różycki Marian Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju hodowli i produkcji zwierzęcej, za osiągnięcia w pracy naukowo-dydaktycznej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
