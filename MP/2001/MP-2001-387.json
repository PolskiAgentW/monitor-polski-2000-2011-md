   "children": []
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Kakarenko Józef, 17. Mierzejewski Andrzej, 18. Pieczyński Andrzej Marian, 19. Pruszko Jan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w promowaniu polskiej gospodarki, za zasługi w organizowaniu Międzynarodowych Targów Poznańskich"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Neuman-Gińska Lidia, 21. Zalewski Bogusław Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w promowaniu polskiej gospodarki, za zasługi w organizowaniu Międzynarodowych Targów Poznańskich:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Trawa Przemysław Kazimierz, 23. Turkiewicz Grzegorz Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Bielazik Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Kujawiak Waldemar Marek, 26. Mazurczak Janusz Michał, 27. Paczkowski Zdzisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w pracy naukowo-badawczej, za działalność na rzecz Ośrodka Badań Naukowych im. Wojciecha Kętrzyńskiego w Olsztynie"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Achremczyk Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w pracy naukowo-badawczej, za działalność na rzecz Ośrodka Badań Naukowych im. Wojciecha Kętrzyńskiego w Olsztynie"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Białuński Grzegorz, 30. Gancewski Jan, 31. Jasiński Grzegorz Marian,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Narewski Ludwik,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Młynarski Benedykt Leon, 34. Szramowski Zdzisław, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Kawecka Danuta, 36. Olszewski Wacław,",
