   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz honorowego krwiodawstwa"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "59",
   "path": "ust_59",
