     "type": "text",
     "text": "STATUT MINISTERSTWA ŚRODOWISKA"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Środowiska, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Środowiska, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 20 października 2001 r. w sprawie szczegółowego zakresu działania Ministra Środowiska (Dz. U. Nr 122, poz. 1345), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "gospodarki wodnej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "środowiska.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
