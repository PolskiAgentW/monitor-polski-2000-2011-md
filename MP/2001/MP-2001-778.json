 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2001/778/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 141 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 31 grudnia 2001 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Środowiska."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 1999 r. Nr 82, poz. 929, z 2000 r. Nr 120, poz. 1268 oraz z 2001 r. Nr 102, poz. 1116 i Nr 154, poz. 1799 i 1800) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Środowiska nadaje sie statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem 1 stycznia 2002 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: L. Miller"
  }
 ],
 "annexes": [
