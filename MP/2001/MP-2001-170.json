 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 28 lutego 2001 r."
  },
  {
   "type": "text",
   "text": "nr 112-4-01"
  },
  {
   "type": "text",
   "text": "o powołaniu na stanowisko sędziego."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483), zgodnie z wnioskiem Krajowej Rady Sądownictwa powołuję niżej wymienione osoby:"
  },
  {
   "type": "text",
   "text": "I. na stanowisko sędziego Sądu Apelacyjnego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Paweł Wojciech RYSIŃSKI — w Warszawie",
   "children": [
    {
     "type": "text",
     "text": "II. na stanowisko sędziego Sądu Okręgowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Joanna Stefania KOZERA — w Katowicach",
   "children": [
    {
     "type": "text",
     "text": "III. na stanowisko sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Mariola BĄKOWSKA — w Przemyślu 4. Paweł Artur CHMIELNICKI — w Kielcach",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Małgorzata Katarzyna GŁOWACKA — w Katowicach 6. Joanna Renata KAWECKA-PYSZ — dla Wrocławia-Krzyki we Wrocławiu 7. Małgorzata Zdzisława KOWALSKA — w Katowicach 8. Katarzyna Magdalena KOZICKA — w Tarnowie 9. Joanna Franciszka LEWCZYŃSKA — w Opatowie",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Wioleta Beata ŁATWIS — w Pszczynie",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Piotr Wiesław MAZIARZ — w Bochni",
   "children": []
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Paweł Jan OZIĘBŁO — w Radomiu",
   "children": []
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Katarzyna Maria PORADA-ŁASKA — w Kępnie",
   "children": []
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Małgorzata Maria STANISŁAWCZYK-KARPIEL — w Tarnowie",
   "children": []
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Rafał Stefan WAGNEROWSKI — w Brzesku",
   "children": []
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Joanna Jadwiga ŻELAZNY — dla Wrocławia-Fabryczna we Wrocławiu",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
