{
 "eli": "MP/2004/529",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 9 lutego 2004 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2004/529/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 16/2004"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 9 lutego 2004 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "w uznaniu wybitnych zasług w pracy naukowej i dydaktycznej, za osiągnięcia w działalności społecznej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM WIELKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Podraza Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju ruchu ludowego, za osiągnięcia w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Harężlak Andrzej Jerzy, 3. Wójcik Józef,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Gmyr Maria Helena,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Brychcy Aleksander Florian, 6. Zydorczak Kryspin Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Piechowiak Krzysztof Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju produkcji rolniczej i przetwórstwa, za aktywną działalność społeczną"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM Z GWIAZDĄ ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Grzegorek Stanisław za zasługi w działalności na rzecz rozwoju produkcji rolniczej i przetwórstwa, za aktywną działalność społeczną:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Strąk Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Wesołowski Janusz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Borowicka Krystyna, 12. Borszyńska Irena, 13. Chojnacka Mirosława, 14. Dylewski Janusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju spółdzielczości mieszkaniowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Kowarczyk Stanisław Stefan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy zawodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Gruber Elżbieta Halina,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Grobelny Jan, 18. Twardowski Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Wawrzyniak Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Dembski Zygmunt, 21. Górski Zdzisław, 22. Walczak Zdzisław, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Dembski Sławomir, 24. Menzel Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy zawodowej i w działalności społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Grajek Jerzy Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla wymiaru sprawiedliwości"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Bladowski Bogdan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Berezowiec Eugeniusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Bolesta Henryk Wiktor,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Szymczuk Walentyna, 30. Ziemcow Jan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Łubiński Wiesław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pracy naukowej i dydaktycznej, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Kowalski Ireneusz Marek, za wybitne zasługi dla rozwoju spółdzielczości mieszkaniowej",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Brągoszewski Wiesław Henryk,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Styra Zdzisław Zygmunt,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju spółdzielczości mieszkaniowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Barczyk Hanna Maria, 36. Makuch Tomasz Antoni,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Banasiak Stanisława,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju ruchu ludowego, za działalność publiczną i społeczną"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Owsianik Bronisław,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Królestwa Hiszpanii"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w rozwijaniu polsko-hiszpańskiej współpracy:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Cuevas José Maria, 40. Fernandez Norniella José Manuel,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Battaner Arias Sebastián, 42. del Pino Calvo-Sotelo Rafael.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
