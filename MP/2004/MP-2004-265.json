{
 "eli": "MP/2004/265",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 26 listopada 2003 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2004/265/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 270/2003"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 26 listopada 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r."
  },
  {
   "type": "text",
   "text": "o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz osób niepełnosprawnych:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Diehl Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Rajtar Krystyna Helena,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Michalczuk Krzysztof Jerzy, 4. Raczkiewicz Stanisława Maria,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób niepełnosprawnych:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Antos Irena Maria, 6. Antos Władysław, 7. Głogowska Elżbieta Maria, 8. Grodzki Zenon, 9. Janocha Andrzej Marek, 10. Peryt Sylwester Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Janocha Joanna Małgorzata, 12. Michałowska Ewa Marta, 13. Orzeł Adam Grzegorz, 14. Piechota Sławomir Jan, 15. Przedpełska-Winiarczyk Marita, 16. Wachowiak-Zwara Beata,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Dzieduszycki Mateusz Jan, 18. Kujawa Elżbieta Katarzyna, 19. Pienczyn Marek,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla ratownictwa górniczego, za osiągnięcia w pracy zawodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Kajdasz Zygmunt Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz polskiego sportu, za osiągnięcia w pracy zawodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Warszawska Helena,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz osób potrzebujących pomocy"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Lichacz Janusz, za wybitne zasługi w działalności na rzecz krzewienia sportu i kultury fizycznej",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Piszcz Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju przedsiębiorczości, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Budrewicz Wiktoria,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju przedsiębiorczości, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Walentynowicz Jan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju budownictwa, za osiągnięcia w pracy zawodowej i działalności społecznej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Filipczak Józef Wiesław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Araszkiewicz Mirosław Julian, 28. Gaworczuk Zenon,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju budownictwa, za osiągnięcia w pracy zawodowej i działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Joniec Jan, 30. Minakowski Włodzimierz Jan,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Dykto Hubert, 32. Grzesik Grażyna, 33. Rzeszut Józef, 34. Wylot Adam,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Ciemięga Janusz, 36. Czółno Wanda,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju kultury, za osiągnięcia w działalności artystycznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Sadowski Krzysztof Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju kultury, za osiągnięcia w pracy artystycznej i dziennikarskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Ostala Janina.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
