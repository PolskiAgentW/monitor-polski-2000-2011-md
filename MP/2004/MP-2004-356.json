{
 "eli": "MP/2004/356",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 9 grudnia 2003 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2004/356/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 278/2003"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 9 grudnia 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r."
  },
  {
   "type": "text",
   "text": "o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne osiągnięcia w dziedzinie nauki o polityce społecznej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Danecki Jan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju telekomunikacji"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Godwod Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla polskiego taternictwa i alpinizmu, za popularyzowanie sportu wspinaczkowego:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Zierhoffer Stanisław Julian,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Cichy Leszek Roman, 5. Morawska-Nowak Barbara Alina, 6. Nyka Józef, 7. Sobolewski Andrzej Zbigniew, 8. Wielicki Krzysztof, 9. Wiktorowska Hanna Ludwika,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla polskiego taternictwa i alpinizmu, za popularyzowanie sportu wspinaczkowego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Ciszewski Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Czerwińska Anna, 12. Kardaś Rafał Mieczysław, 13. Święcicki Wojciech Rafał, za wybitne zasługi dla ochrony środowiska naturalnego, za działalność w Polskim Związku Łowieckim",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Rembiasz Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju ubezpieczeń społecznych, za działalność publiczną"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Wiktorow Aleksandra,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju polskiej poligrafii"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Florysiak Edward Jerzy, 17. Kwiatkowski Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju polskiej poligrafii:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Grupiński Rafał Szymon, 19. Pindral Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Olesiejuk Jacek Jarosław, 21. Nazar Cezary,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Bromirska Małgorzata Stanisława,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz dzieci i młodzieży"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Skwierawski Andrzej.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
