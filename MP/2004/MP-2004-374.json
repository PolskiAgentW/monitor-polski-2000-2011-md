     "text": "STATUT MINISTERSTWA GOSPODARKI I PRACY"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Gospodarki i Pracy, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Gospodarki i Pracy, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 4 maja 2004 r. w sprawie szczegółowego zakresu działania Ministra Gospodarki i Pracy (Dz. U. Nr 106, poz. 1120), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "gospodarki;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "pracy;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "rozwoju regionalnego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/pkt_4",
       "text": "turystyki.",
       "children": []
      }
     ]
    },
