         "text": "„s) Departament do Spraw Restrukturyzacji Finansów Publicznych,”.",
         "quoted": true
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
