 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 6 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 28 stycznia 2004 r."
  },
  {
   "type": "text",
   "text": "zmieniające zarządzenie w sprawie nadania statutu Ministerstwu Finansów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199 i Nr 80, poz. 717) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W zarządzeniu nr 22 Prezesa Rady Ministrów z dnia 13 lutego 2002 r. w sprawie nadania statutu Ministerstwu Finansów (M. P. Nr 8, poz. 150, Nr 15, poz. 248 i Nr 38, poz. 602 oraz z 2003 r. Nr 18, poz. 283 i Nr 59, poz. 929) w załączniku wprowadza się następujące zmiany:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "w § 2:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "pkt 7a otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„7a) Departament do Spraw Restrukturyzacji Finansów Publicznych,”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "pkt 8 otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„8) Departament Instytucji Płatniczej,”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "pkt 11 otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„11) Departament Integracji Europejskiej,”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_1/lit_d",
       "text": "pkt 30 otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„30) Biuro Kontroli Wewnętrznej i Ochrony Informacji Niejawnych,”,",
         "quoted": true
        }
       ]
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_1/lit_e",
       "text": "pkt 32 otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„32) Biuro Komunikacji Społecznej,”;",
         "quoted": true
        }
       ]
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "w § 3 w pkt 2:",
     "children": [
      {
       "type": "lit",
