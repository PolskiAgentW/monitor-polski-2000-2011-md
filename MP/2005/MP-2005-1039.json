 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 118 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 22 listopada 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Transportu i Budownictwa"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Transportu i Budownictwa nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: K. Marcinkiewicz"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 118 Prezesa Rady Ministrów z dnia 22 listopada 2005 r. (poz. 1039)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA TRANSPORTU I BUDOWNICTWA"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Transportu i Budownictwa, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Transportu i Budownictwa, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 31 października 2005 r. w sprawie szczegółowego zakresu działania Ministra Transportu i Budownictwa (Dz. U. Nr 220, poz. 1900), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "budownictwa, gospodarki przestrzennej i mieszkaniowej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "gospodarki morskiej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "łączności;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/pkt_4",
       "text": "transportu.",
       "children": []
      }
     ]
    },
