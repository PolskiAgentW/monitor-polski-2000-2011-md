   "type": "text",
   "text": "UCHWAŁA SEJMU RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 26 października 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie wyboru wicemarszałków Sejmu"
  },
  {
   "type": "text",
   "text": "Sejm Rzeczypospolitej Polskiej, na podstawie art. 110 ust. 1 Konstytucji Rzeczypospolitej Polskiej, dokonuje wyboru posłów:"
  },
  {
   "type": "text",
   "text": "— Jarosława KALINOWSKIEGO"
  },
  {
   "type": "text",
   "text": "— Bronisława KOMOROWSKIEGO"
  },
  {
   "type": "text",
   "text": "— Marka KOTLINOWSKIEGO — Andrzeja LEPPERA"
  },
  {
   "type": "text",
   "text": "— Wojciecha OLEJNICZAKA"
  },
  {
   "type": "text",
   "text": "na stanowiska wicemarszałków Sejmu."
  },
  {
   "type": "signature",
   "text": "Marszałek Sejmu: M. Jurek"
  }
 ],
