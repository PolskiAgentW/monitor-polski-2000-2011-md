   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA SPRAW WEWNĘTRZNYCH I ADMINISTRACJI"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Spraw Wewnętrznych i Administracji, zwane dalej „ministerstwem”, zapewnia obsługę Ministra Spraw Wewnętrznych i Administracji właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 31 października 2005 r. w sprawie szczegółowego zakresu działania Ministra Spraw Wewnętrznych i Administracji (Dz. U. Nr 220, poz. 1897), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "administracji publicznej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "informatyzacji;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "wewnętrznych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/pkt_4",
       "text": "wyznań religijnych oraz mniejszości narodowych i etnicznych.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
