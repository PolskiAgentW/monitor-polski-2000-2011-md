{
 "eli": "MP/2005/1011",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 25 lipca 2005 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2005/1011/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 195/2005"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 25 lipca 2005 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676), na wniosek Ministra Spraw Zagranicznych, odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "obywatelka Republiki Francuskiej"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w popularyzowaniu kultury polskiej, za działalność polonijną"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Gomes Coelho Maria Barbara,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Rzeczypospolitej Polskiej i Kanady"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności polonijnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Dobrowolski Jerzy Adam, za wybitne zasługi w popularyzowaniu kultury polskiej",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Koprowski Piotr Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności polonijnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kielar Stanisław Rafał,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w popularyzowaniu kultury polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Knapik-Sztramko Maria Agata,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Federacji Rosyjskiej"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej, za popularyzowanie kultury polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Afanasjewa Stanisława, 7. Bryżko Ludmiła, 8. Fiel Sergiusz, 9. Guziejewa Aleksandra, 10. Leończyk Sergiusz, obywatele Rzeczypospolitej Polskiej zamieszkali w Republice Singapuru",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w rozwijaniu polsko-singapurskiej współpracy naukowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Nowiński Wiesław Lucjan, 12. Olszewski Piotr Szczęsny,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Republiki Singapuru"
    },
    {
     "type": "text",
     "text": "za zasługi w rozwijaniu polsko-singapurskiej współpracy"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Chung Sang Hong",
   "children": [
    {
     "type": "text",
     "text": "obywatelka Konfederacji Szwajcarskiej"
    },
    {
     "type": "text",
     "text": "za zasługi dla rozwoju kultury, za osiągnięcia w działalności artystycznej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Szreder Saskia,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Królestwa Szwecji"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w rozwijaniu polsko-szwedzkiej współpracy"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Amberg Jan Henrik,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności polonijnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Wereda Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Al-Basri Jolanta,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Rzeczypospolitej Polskiej zamieszkali w Królestwie Szwecji"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Klich Maciej,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Domagała Magdalena, obywatele Ukrainy",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju kultury, za osiągnięcia w działalności artystycznej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Bilyak Rostyslav, 21. Fedorova Nataliya,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Rzeczypospolitej Polskiej i Zjednoczonego Królestwa Wielkiej Brytanii i Irlandii Północnej"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności kombatanckiej i społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Nitzke Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności charytatywnej na rzecz dzieci głuchoniemych"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Dembińska Stefania Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Rzeczypospolitej Polskiej zamieszkali w Zjednoczonym Królestwie Wielkiej Brytanii i Irlandii Północnej"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności kombatanckiej i społecznej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Kowalski Zbigniew Stanisław, 25. Stefański Zbigniew, 26. Włodzik Bolesław Jan,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Maryniak Roman,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz środowisk polonijnych"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "ks. Tyliszczak Krzysztof Bogusław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Stefanicka Anna Maria.",
   "children": []
  },
  {
   "type": "signature",
