{
 "eli": "MP/2005/224",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 17 listopada 2004 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2005/224/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 282/2004 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 17 listopada 2004 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz ruchu studenckiego:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Lewandowski Tadeusz Ignacy,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Gordon Andrzej Zbigniew, 3. Grześczak Marian Antoni,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Dzierżawski Adam Edward, 5. Opala Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ruchu studenckiego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Stelmaszczuk Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Galik Jadwiga Urszula, 8. Lipa Irmina, 9. Pakulski Marek Henryk,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Kazimierski Grzegorz Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności związkowej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Simbierowicz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Chrostek Leokadia, 13. Drozd Jerzy Jan, 14. Jasiński Jerzy Wacław, 15. Kotulski Leonard Ernest, 16. Miszczyk Bronisław, KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI",
   "children": []
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Gawin Tadeusz, 18. Pałka Stanisław, 19. Sommer Eugeniusz Franciszek, 20. Woźny Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności związkowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Lipiec Janusz Aleksander, 22. Piątkowski Andrzej Bronisław, 23. Szczepański Andrzej Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi na rzecz rozwoju kolejnictwa"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Suwalski Ryszard Maria,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w działalności artystycznej i społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Maciejewski Józef,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w działalności artystycznej i społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Wilczarska Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Gabler Sylwester, 28. Konieczna Czesława, 29. Łukowiak Mirosława, 30. Maciejewska Maria.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
