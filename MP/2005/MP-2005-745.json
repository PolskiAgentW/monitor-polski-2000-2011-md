{
 "eli": "MP/2005/745",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 21 kwietnia 2005 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2005/745/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 82/2005 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 21 kwietnia 2005 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności kombatanckiej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Praczuk Eugeniusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy zawodowej i społecznej, za osiągnięcia w promowaniu polskiej nauki i kultury"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Grzesiak Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności naukowo-dydaktycznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Wrocławski Krzysztof Dominik,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pracy zawodowej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Broszczak Anna Elżbieta, 5. Doliński Ignacy Maciej, 6. Kłos Zdzisław, 7. Piotrowska-Małek Teresa Maria, 8. Szwat-Gyłybow Grażyna, za wybitne zasługi dla rozwoju sportu, za osiągnięcia w działalności społecznej",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Schmelter Tadeusz Ignacy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju sportu, za osiągnięcia w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Motylewski Ryszard Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Kensik Jan, 12. Laszuk Antoni, 13. Mikołajczak Aleksander, 14. Przybyszewski Andrzej Henryk,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Matus Marek, 16. Talkowski Krzysztof Bolesław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju regionu Warmii i Mazur:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Andrejczuk Jan, 18. Kokot Ryszard, 19. Kozyra Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Cytowski Ryszard, 21. Kołakowski Andrzej Czesław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Supranowicz Marzenna Jolanta.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
