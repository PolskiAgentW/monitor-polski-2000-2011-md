{
 "eli": "MP/2005/585",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 15 lutego 2005 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2005/585/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 25/2005"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 15 lutego 2005 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju kultury polskiej, za osiągnięcia w pracy artystycznej i dydaktycznej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Jasiński Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Hawel Jan Wincenty,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Growiec Michalina, 4. Knapik Eugeniusz, 5. Stańczyk Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w pracy artystycznej, za zasługi w działalności dydaktycznej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Ballarin Jan, 7. Zubek Andrzej, za wybitne osiągnięcia w działalności artystycznej, za zasługi dla rozwoju kultury",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Szwacz Bogusław Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy dziennikarskiej, za działalność na rzecz pojednania polsko-niemieckiego"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Siekierska Anna Danuta,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla ochrony zdrowia, za działalność na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Masiakowski Bogumił Leon, 11. Ożegowski Przemysław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Niemiec Józef, za zasługi dla ochrony zdrowia, za działalność na rzecz społeczności lokalnej",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Parachimowicz Józef Leszek,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju przedsiębiorczości, za osiągnięcia w pracy naukowej i dydaktycznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Czechowicz Kazimierz Bolesław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w przeciwdziałaniu zagrożeniom biologicznym, za osiągnięcia w pracy naukowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Majcherczyk Stanisław Józef,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju hodowli bydła, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Łapawa Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju hodowli bydła, za działalność społeczną:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Dymarski Ireneusz, 18. Frala Kazimierz, 19. Łagódka Jan, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Bogdański Janusz Robert, 21. Czarnecki Mikołaj Piotr, 22. Czubak Zenon, 23. Dymarski Tadeusz, 24. Jabłoński Eugeniusz Józef, 25. Jagła Przemysław Władysław, 26. Olejniczak Henryk, 27. Pankowski Marian Bolesław, 28. Wawrzyniak Wojciech Walenty,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Szwedek Zygmunt Sławomir,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla Śląska Cieszyńskiego"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Żur Anastazja,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla Śląska Cieszyńskiego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Bernacka-Frankowska Aleksandra,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Wąsowicz Jadwiga Ewa.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
