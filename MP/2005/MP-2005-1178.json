{
 "eli": "MP/2005/1178",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 10 października 2005 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2005/1178/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 264/2005"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 10 października 2005 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne osiągnięcia w pracy naukowej, za rozwijanie międzynarodowej współpracy edukacyjnej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "ks. Kryński Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "o. Rakoczy Bolesław Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy naukowej i dydaktycznej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Chmura Andrzej Mateusz, 4. Durlik Magdalena Joanna,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju endokrynologii i medycyny nuklearnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Kozłowicz-Gudzińska Izabella Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w promowaniu polskiej kultury ludowej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Jaśkiewicz Danuta Jadwiga, 7. Jaśkiewicz Henryk Józef,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju spółdzielczości"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Ożóg Irena Władysława,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju spółdzielczości:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Bednarski Andrzej Mieczysław, 10. Michalak Sabina, 11. Skupińska Krystyna Sabina, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Musiał Włodzimierz Bogdan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy zawodowej na rzecz rozwoju drogownictwa:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Bilski Włodzimierz Wojciech, 14. Florczyk Grzegorz, 15. Kotlarek Zbigniew Zenon,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Buszkiewicz Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju budownictwa"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Wojdyła Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju budownictwa:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Napora Jan, 19. Staroń Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Kozera Andrzej, 21. Treliński Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju kultury"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Cygański Janusz Aleksander,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla wymiaru sprawiedliwości"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Łączkowski Andrzej Roman,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Rokosz-Kuczyński Gniewomir Gwidon, 25. Zalewski Adam Jan, obywatel Państwa Izrael",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w rozwijaniu stosunków polsko-żydowskich"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Kantor Viatcheslav,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Republiki Federalnej Niemiec:"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju współpracy samorządowej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Zuber Walter, KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ",
   "children": []
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Benkert Knut, 29. Wagner Volker,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w rozwijaniu polsko-niemieckiej współpracy naukowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Kramer Matthias.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
