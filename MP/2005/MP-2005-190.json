 "body": [
  {
   "type": "text",
   "text": "Rej. 269/2004"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 4 listopada 2004 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla kultury polskiej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Komorowska-Tyszkiewicz Maria, 2. Śmiałowski Igor,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Derfel Jerzy, 4. Tym Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju wsi i rolnictwa:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Czuba Józef Wojciech, 6. Płowucha Maria, KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Górczyński Jan, 8. Rataj Edward,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju wsi i rolnictwa:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Kąkol Józef, 10. Mzyk Anna, 11. Szymczak Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Kosiewicz Mirosław, 13. Łuczak Krystyna, 14. Musiał Wiesława, 15. Nowak Lucyna, 16. Poks Eleonora, 17. Wojciechowski Kazimierz Jan,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Janik Jolanta Janina,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności kombatanckiej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Leparowski Leon, KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI",
   "children": []
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Dachowski Kazimierz Bolesław, 21. Guliński Ireneusz, 22. Słowikowski Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pracy zawodowej, za osiągnięcia w działalności społecznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Dąbrowski Janusz Feliks, 24. Jankowska Anna Maria, 25. Sroka Krystyna Alicja,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Baluta Grzegorz Jan, 27. Christa Jerzy, 28. Rymko Andrzej Wiesław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju polskiego lotnictwa sportowego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Doktor-Diłaj Irena, 30. Mruk Andrzej Adam,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Kawa Sebastian Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju i popularyzacji sportu motorowodnego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Bagniewski Henryk, 33. Korzeniowski Hubert Michał, 34. Tomankiewicz Andrzej Józef, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Bielawski Bogusław Edmund, 36. Bytner Waldemar, 37. Grabowski Andrzej, 38. Prądzyński Andrzej Paweł, 39. Szydlik Bogdan Wojciech, 40. Wlaźnik Jan Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Andrzejczak Mariusz Alfred, 42. Zdzieszyńska Małgorzata Anna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności kombatanckiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Nawrot Andrzej, 44. Nowakowski Wiesław, 45. Wawrzyniak Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Morawiec Wojciech, 47. Pawłowski Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności kombatanckiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Skibiński Mirosław, 49. Wójcik Feliks.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
