{
 "eli": "MP/2005/1096",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 9 września 2005 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2005/1096/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 240/2005"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 9 września 2005 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju polskiej wsi i rolnictwa:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Cisowski Tadeusz Józef, 2. Laskowski Włodzimierz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Grabowski Jerzy Waldemar, 4. Kowalski Marian, 5. Turzyński Józef Mikołaj, 6. Zięba Julian Zbigniew, za zasługi dla rozwoju polskiej wsi i rolnictwa:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Dańczyszyn Dariusz Józef, 8. Ptaszek Jarosław Hieronim,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Głuszyński Alfred, 10. Jędrys Józef,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Janoch Paweł.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
