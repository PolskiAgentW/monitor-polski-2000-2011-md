 "body": [
  {
   "type": "text",
   "text": "OBWIESZCZENIE MINISTRA FINANSÓW[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 21 grudnia 2005 r."
  },
  {
   "type": "text",
   "text": "w sprawie ogłoszenia rejestru aktuariuszy"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 161 ust. 5 ustawy z dnia 22 maja 2003 r. o działalności ubezpieczeniowej (Dz. U."
  },
  {
   "type": "text",
   "text": "Nr 124, poz. 1151, z późn. zm.[^2]) ogłasza się rejestr aktuariuszy, stanowiący załącznik do obwieszczenia."
  },
  {
   "type": "text",
   "text": "Minister Finansów: w z. E. Suchocka-Roguska"
  }
 ],
