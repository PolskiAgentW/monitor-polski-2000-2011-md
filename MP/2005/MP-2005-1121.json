     "type": "text",
     "text": "STATUT MINISTERSTWA GOSPODARKI"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Gospodarki, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Gospodarki, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 31 października 2005 r. w sprawie szczegółowego zakresu działania Ministra Gospodarki (Dz. U. Nr 220, poz. 1888), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "gospodarki;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "turystyki.",
       "children": []
      }
     ]
    },
