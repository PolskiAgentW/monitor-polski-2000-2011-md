{
 "eli": "MP/2006/386",
 "title": "Zarządzenie Nr 80 Prezesa Rady Ministrów z dnia 19 maja 2006 r. w sprawie nadania statutu Ministerstwu Edukacji Narodowej",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2006/386/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 80 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 19 maja 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Edukacji Narodowej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Edukacji Narodowej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: K. Marcinkiewicz"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 80 Prezesa Rady Ministrów z dnia 19 maja 2006 r. (poz. 386)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA EDUKACJI NARODOWEJ"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Edukacji Narodowej, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Edukacji Narodowej, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 5 maja 2006 r. w sprawie szczegółowego zakresu działania Ministra Edukacji Narodowej (Dz. U. Nr 76, poz. 538), do spraw oświaty i wychowania.",
     "children": []
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "W skład Ministerstwa wchodzi Gabinet Polityczny Ministra oraz następujące komórki organizacyjne:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_2/pkt_1",
       "text": "Departament Kształcenia Ogólnego i Specjalnego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_2/pkt_2",
       "text": "Departament Nadzoru Oświatowego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_2/pkt_3",
       "text": "Departament Kształcenia Zawodowego i Ustawicznego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_2/pkt_4",
       "text": "Departament Młodzieży i Wychowania;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_2/pkt_5",
       "text": "Departament Kształcenia i Doskonalenia Nauczycieli;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_2/pkt_6",
       "text": "Departament Pragmatyki Zawodowej Nauczycieli;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_2/pkt_7",
       "text": "Departament Współpracy Międzynarodowej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_2/pkt_8",
       "text": "Departament Ekonomiczny;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "9",
       "path": "par_2/pkt_9",
       "text": "Departament Funduszy Strukturalnych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "10",
       "path": "par_2/pkt_10",
       "text": "Departament Prawny;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "11",
       "path": "par_2/pkt_11",
       "text": "Biuro Wdrażania Europejskiego Funduszu Społecznego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "12",
       "path": "par_2/pkt_12",
       "text": "Biuro Kontroli i Audytu;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "13",
       "path": "par_2/pkt_13",
       "text": "Biuro Dyrektora Generalnego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "14",
       "path": "par_2/pkt_14",
       "text": "Biuro Informacji i Promocji;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "15",
       "path": "par_2/pkt_15",
       "text": "Biuro Administracyjne;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "16",
       "path": "par_2/pkt_16",
       "text": "Biuro Kadr i Szkolenia;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "17",
       "path": "par_2/pkt_17",
       "text": "Biuro Spraw Obronnych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "18",
       "path": "par_2/pkt_18",
       "text": "Stanowisko do Spraw Ochrony Informacji Niejawnych.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "3",
     "path": "par_3",
     "text": "Bezpośredni nadzór nad Gabinetem Politycznym Ministra sprawuje Minister.",
     "children": []
    }
   ]
  }
 ],
