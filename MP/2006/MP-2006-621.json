 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 133 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 25 sierpnia 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Finansów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Finansów nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 62 Prezesa Rady Ministrów z dnia 28 kwietnia 2006 r. w sprawie nadania statutu Ministerstwu Finansów (M. P. Nr 32, poz. 351).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Kaczyński"
  }
 ],
 "annexes": [
