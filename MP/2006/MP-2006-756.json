{
 "eli": "MP/2006/756",
 "title": "Zarządzenie Ministra Obrony Narodowej z dnia 20 października 2006 r. w sprawie nadania statutu Służbie Kontrwywiadu Wojskowego",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2006/756/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE MINISTRA OBRONY NARODOWEJ"
  },
  {
   "type": "text",
   "text": "z dnia 20 października 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Służbie Kontrwywiadu Wojskowego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 21 ust. 1 ustawy z dnia 9 czerwca 2006 r. o Służbie Kontrwywiadu Wojskowego oraz Służbie Wywiadu Wojskowego (Dz. U. Nr 104, poz. 709) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Służbie Kontrwywiadu Wojskowego nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia, z mocą od dnia 1 października 2006 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Obrony Narodowej: R. Sikorski"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia Ministra Obrony Narodowej z dnia 20 października 2006 r. (poz. 756)",
   "body": [
    {
     "type": "text",
     "text": "STATUT SŁUŻBY KONTRWYWIADU WOJSKOWEGO"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Służba Kontrwywiadu Wojskowego, zwana dalej „SKW”, działa na podstawie ustawy z dnia 9 czerwca 2006 r. o Służbie Kontrwywiadu Wojskowego oraz Służbie Wywiadu Wojskowego, aktów wykonawczych do tej ustawy, w tym niniejszego statutu oraz innych obowiązujących przepisów ustawowych, zawierających zadania dla SKW.",
     "children": []
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "",
     "children": [
      {
       "type": "ust",
       "num": "1",
       "path": "par_2/ust_1",
       "text": "Szef SKW kieruje podległą służbą bezpośrednio lub przez swoich zastępców oraz dyrektorów (kierowników) jednostek organizacyjnych SKW.",
       "children": []
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_2/ust_2",
       "text": "Szefa SKW, w czasie jego nieobecności, zastępuje wyznaczony przez niego zastępca, działający w ramach udzielonych mu przez Szefa SKW pełnomocnictw.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "3",
     "path": "par_3",
     "text": "",
     "children": [
      {
       "type": "ust",
       "num": "1",
       "path": "par_3/ust_1",
       "text": "W skład SKW wchodzą następujące jednostki organizacyjne:",
       "children": [
        {
         "type": "pkt",
         "num": "1",
         "path": "par_3/ust_1/pkt_1",
         "text": "Zarząd I;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "2",
         "path": "par_3/ust_1/pkt_2",
         "text": "Zarząd II;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "3",
         "path": "par_3/ust_1/pkt_3",
         "text": "Zarząd III;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "4",
         "path": "par_3/ust_1/pkt_4",
         "text": "Biuro Ochrony Informacji Niejawnych;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "5",
         "path": "par_3/ust_1/pkt_5",
         "text": "Biuro „O”;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "6",
         "path": "par_3/ust_1/pkt_6",
         "text": "Biuro „R”;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "7",
         "path": "par_3/ust_1/pkt_7",
         "text": "Biuro „T”;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "8",
         "path": "par_3/ust_1/pkt_8",
         "text": "Biuro „W”;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "9",
         "path": "par_3/ust_1/pkt_9",
         "text": "Biuro Logistyki;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "10",
         "path": "par_3/ust_1/pkt_10",
         "text": "Biuro Finansów;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "11",
         "path": "par_3/ust_1/pkt_11",
         "text": "Biuro Ewidencji i Archiwum;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "12",
         "path": "par_3/ust_1/pkt_12",
         "text": "Biuro Kadr;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "13",
         "path": "par_3/ust_1/pkt_13",
         "text": "Biuro Pełnomocnika Ochrony;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "14",
         "path": "par_3/ust_1/pkt_14",
         "text": "Ośrodek Szkolenia SKW;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "15",
         "path": "par_3/ust_1/pkt_15",
         "text": "Zespół Specjalistów;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "16",
         "path": "par_3/ust_1/pkt_16",
         "text": "Zespół Audytu Wewnętrznego;",
         "children": []
        },
        {
         "type": "pkt",
         "num": "17",
         "path": "par_3/ust_1/pkt_17",
         "text": "Gabinet Szefa SKW.",
         "children": []
        }
       ]
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_3/ust_2",
       "text": "Szczegółową strukturę, organizację wewnętrzną oraz zakres zadań jednostek i komórek organizacyjnych SKW określa Szef SKW w regulaminach organizacyjnych tych jednostek.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "4",
     "path": "par_4",
     "text": "Spory kompetencyjne pomiędzy jednostkami lub komórkami organizacyjnymi wchodzącymi w skład SKW rozstrzyga Szef SKW.",
     "children": []
    },
    {
     "type": "par",
     "num": "5",
     "path": "par_5",
     "text": "Szef SKW może powoływać kolegialne organy doradcze i opiniodawcze, określając ich nazwę, skład osobowy oraz szczegółowy zakres i tryb działania.",
     "children": []
    }
   ]
  }
 ],
 "footnotes": {}
}
