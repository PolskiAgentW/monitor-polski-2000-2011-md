{
 "eli": "MP/2006/61",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 5 grudnia 2005 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2006/61/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 320/2005"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 5 grudnia 2005 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz rozwoju gospodarki:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Dryll-Gutkowska Irena,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Dzięciołowski Jerzy Olgierd,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Makowiecki Jan Marcin,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju gospodarki"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Baczko Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w propagowaniu polskiego folkloru"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Krupczyńska Aniela Magdalena,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Mastalski Stanisław Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy zawodowej, za działalność na rzecz środowiska lokalnego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Ojczyk Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju sportu"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Sokołowska Celina,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju sportu"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Starowicz Marta Elżbieta, za wybitne zasługi w pracy zawodowej",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Krawycińska Maria, 11. Polkowski Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pracy zawodowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Dorau Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Bibersztajn Teresa, 14. Brzezicki Sławomir, 15. Krużewska Hanna, 16. Żarski Jacek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Buze Anita Agata, 18. Dalke Dariusz, 19. Romanowska Teresa, 20. Szulc Hanna, 21. Urbański Dariusz, 22. Weber Jadwiga, 23. Wiese Waldemar,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności publicznej i związkowej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Cybulski Zygmunt Alojzy,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Kaniewski Zbigniew Waldemar, 26. Otręba Andrzej Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności publicznej i związkowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Stępień Marian Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Grabowski Marek Ludwik, 29. Jurgielaniec Seweryn Leszek,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz organizacji kombatanckiej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Hajczuk Anatol, za zasługi w działalności społecznej i charytatywnej:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "ks. Adamowicz Daniel, 32. Kaszuba Zofia,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Kosińska Hanna Maria, 34. Wolska Danuta Maria, 35. Wysocki Witold Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju kultury"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Kowalska-Pińczak Alina,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju kultury:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Szyszko Romuald,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Grzona-Worzała Jolanta, 39. Kowacz Katarzyna, 40. Okrój Adam, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Chomicz Małgorzata, 42. Lach-Owsiany Alicja, 43. Rogalska Katarzyna Małgorzata, 44. Wdziękoński Damian,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w ujawnianiu i udokumentowaniu prawdy o Zbrodni Katyńskiej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Bragin Wiaczesław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Gołowkin Anatolij, 47. Jeszczenko Boris.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
