   "path": "ust_28",
   "text": "Bugajczyk Bożena Czesława, 29. Oder Wiesława Irena, 30. Sochocka-Bykowska Małgorzata Paulina, 31. Wojciechowska Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
