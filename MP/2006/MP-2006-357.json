 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 72 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 11 maja 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Transportu"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Transportu nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: K. Marcinkiewicz"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 72 Prezesa Rady Ministrów z dnia 11 maja 2006 r. (poz. 357)",
   "body": [
