 "body": [
  {
   "type": "text",
   "text": "UCHWAŁA Nr 120 RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 12 lipca 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie zatwierdzenia Programu rzeczowo-finansowego wykorzystania środków Funduszu Kolejowego w 2006 roku"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 9 ust. 3 ustawy z dnia 16 grudnia 2005 r. o Funduszu Kolejowym (Dz. U. z 2006 r. Nr 12, poz. 61) Rada Ministrów uchwala, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Zatwierdza się Program rzeczowo-finansowy wykorzystania środków Funduszu Kolejowego w 2006 roku, stanowiący załącznik do uchwały.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Uchwała wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: K. Marcinkiewicz"
  }
 ],
