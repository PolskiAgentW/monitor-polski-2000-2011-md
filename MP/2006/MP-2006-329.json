{
 "eli": "MP/2006/329",
 "title": "Zarządzenie Nr 60 Prezesa Rady Ministrów z dnia 25 kwietnia 2006 r. w sprawie Międzyresortowego Zespołu do spraw opracowania Strategii Bezpieczeństwa Narodowego Rzeczypospolitej Polskiej",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2006/329/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 60 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 25 kwietnia 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie Międzyresortowego Zespołu do spraw opracowania Strategii Bezpieczeństwa Narodowego Rzeczypospolitej Polskiej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 12 ust. 1 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Tworzy się Międzyresortowy Zespół do spraw opracowania Strategii Bezpieczeństwa Narodowego Rzeczypospolitej Polskiej, zwany dalej „Zespołem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Zespół jest organem pomocniczym Rady Ministrów.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Do zadań Zespołu należy:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "opracowanie harmonogramu prac Zespołu;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "dokonanie przeglądu i analizy uwarunkowań związanych ze środowiskiem bezpieczeństwa narodowego Rzeczypospolitej Polskiej;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "opracowanie projektu Strategii Bezpieczeństwa Narodowego Rzeczypospolitej Polskiej i przedłożenie go Radzie Ministrów.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "W skład Zespołu wchodzą:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_3/pkt_1",
     "text": "przewodniczący — podsekretarz stanu w Ministerstwie Obrony Narodowej;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_3/pkt_2",
     "text": "wiceprzewodniczący:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_3/pkt_2/lit_a",
       "text": "podsekretarz stanu w Ministerstwie Spraw Zagranicznych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_3/pkt_2/lit_b",
       "text": "podsekretarz stanu w Ministerstwie Spraw Wewnętrznych i Administracji;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_3/pkt_3",
     "text": "członkowie wyznaczeni przez:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_3/pkt_3/lit_a",
       "text": "Ministra Edukacji i Nauki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_3/pkt_3/lit_b",
       "text": "Ministra Finansów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_3/pkt_3/lit_c",
       "text": "Ministra Gospodarki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_3/pkt_3/lit_d",
       "text": "Ministra Pracy i Polityki Społecznej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_3/pkt_3/lit_e",
       "text": "Ministra Transportu i Budownictwa,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_3/pkt_3/lit_f",
       "text": "Ministra Kultury i Dziedzictwa Narodowego,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_3/pkt_3/lit_g",
       "text": "Ministra Rozwoju Regionalnego,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_3/pkt_3/lit_h",
       "text": "Ministra Obrony Narodowej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_3/pkt_3/lit_i",
       "text": "Ministra Rolnictwa i Rozwoju Wsi,",
       "children": []
      },
      {
       "type": "lit",
       "num": "j",
       "path": "par_3/pkt_3/lit_j",
       "text": "Ministra Skarbu Państwa,",
       "children": []
      },
      {
       "type": "lit",
       "num": "k",
       "path": "par_3/pkt_3/lit_k",
       "text": "Ministra Sportu,",
       "children": []
      },
      {
       "type": "lit",
       "num": "l",
       "path": "par_3/pkt_3/lit_l",
       "text": "Ministra Sprawiedliwości,",
       "children": []
      },
      {
       "type": "lit",
       "num": "m",
       "path": "par_3/pkt_3/lit_m",
       "text": "Ministra Spraw Wewnętrznych i Administracji,",
       "children": []
      },
      {
       "type": "lit",
       "num": "n",
       "path": "par_3/pkt_3/lit_n",
       "text": "Ministra Spraw Zagranicznych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "o",
       "path": "par_3/pkt_3/lit_o",
       "text": "Ministra Środowiska,",
       "children": []
      },
      {
       "type": "lit",
       "num": "p",
       "path": "par_3/pkt_3/lit_p",
       "text": "Ministra Zdrowia,",
       "children": []
      },
      {
       "type": "lit",
       "num": "q",
       "path": "par_3/pkt_3/lit_q",
       "text": "Ministra-członka Rady Ministrów Z. Wassermanna,",
       "children": []
      },
      {
       "type": "lit",
       "num": "r",
       "path": "par_3/pkt_3/lit_r",
       "text": "Szefa Kancelarii Prezesa Rady Ministrów,",
       "children": []
      },
      {
       "type": "lit",
       "num": "s",
       "path": "par_3/pkt_3/lit_s",
       "text": "Szefa Urzędu Komitetu Integracji Europejskiej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "t",
       "path": "par_3/pkt_3/lit_t",
       "text": "Szefa Agencji Bezpieczeństwa Wewnętrznego,",
       "children": []
      },
      {
       "type": "lit",
       "num": "u",
       "path": "par_3/pkt_3/lit_u",
       "text": "Szefa Agencji Wywiadu.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_4/ust_1",
     "text": "Pracami Zespołu kieruje przewodniczący, a w razie jego nieobecności — wyznaczony przez niego wiceprzewodniczący.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_4/ust_2",
     "text": "Posiedzenia Zespołu zwołuje przewodniczący albo w jego zastępstwie — wiceprzewodniczący.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_4/ust_3",
     "text": "W celu realizacji zadań zespołu przewodniczący zaprosi do pracy przedstawicieli Prezydenta Rzeczypospolitej Polskiej oraz może, z własnej inicjatywy lub na wniosek członka Zespołu, zapraszać do udziału w pracach Zespołu inne osoby niż wymienione w § 3 pkt 3, a w szczególności przedstawicieli parlamentu, innych instytucji państwowych, środowisk naukowych i eksperckich.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_4/ust_4",
     "text": "Przewodniczący może, spośród członków Zespołu, utworzyć grupy robocze do realizacji poszczególnych zadań należących do zakresu działania Zespołu.",
     "children": []
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_4/ust_5",
     "text": "Przewodniczący Zespołu może powierzać poszczególnym członkom Zespołu wykonanie określonych prac, niezbędnych do realizacji jego zadań.",
     "children": []
    },
    {
     "type": "ust",
     "num": "6",
     "path": "par_4/ust_6",
     "text": "Szczegółowy tryb pracy Zespołu określa regulamin ustalony przez przewodniczącego Zespołu.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "Przewodniczący Zespołu w terminie do dnia 30 czerwca 2007 r. przedstawi Radzie Ministrów projekt Strategii Bezpieczeństwa Narodowego Rzeczypospolitej Polskiej.",
   "children": []
  },
  {
   "type": "par",
   "num": "6",
   "path": "par_6",
   "text": "Obsługę prac Zespołu zapewnia Ministerstwo Obrony Narodowej.",
   "children": []
  },
  {
   "type": "par",
   "num": "7",
   "path": "par_7",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: K. Marcinkiewicz"
  }
 ],
 "annexes": [],
 "footnotes": {
  "1": "Zmiany tekstu jednolitego wymienionej ustawy zostały ogłoszone w Dz. U. z 2003 r. Nr 80, poz. 717, z 2004 r. Nr 238, poz. 2390 i Nr 273, poz. 2703, z 2005 r. Nr 169, poz. 1414 i Nr 249, poz. 2104 oraz z 2006 r. Nr 45, poz. 319."
 }
}
