 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 28 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 21 lutego 2006 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Sportu"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Sportu nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 80 Prezesa Rady Ministrów z dnia 2 września 2005 r. w sprawie nadania statutu Ministerstwu Sportu (M. P. Nr 51, poz. 706).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: K. Marcinkiewicz"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 28 Prezesa Rady Ministrów z dnia 21 lutego 2006 r. (poz. 177)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA SPORTU"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Sportu, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Sportu, zwanego dalej „Ministrem”, właściwego, na podstawie § 1 ust. 2 rozporządzenia Prezesa Rady Ministrów z dnia 31 października 2005 r. w sprawie szczegółowego zakresu działania Ministra Sportu (Dz. U. Nr 220, poz. 1895), do spraw kultury fizycznej i sportu.",
     "children": []
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "W skład Ministerstwa wchodzi Gabinet Polityczny Ministra oraz następujące komórki organizacyjne:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_2/pkt_1",
       "text": "Departament Ekonomiczno-Finansowy;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_2/pkt_2",
       "text": "Departament Infrastruktury Sportowej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_2/pkt_3",
       "text": "Departament Doskonalenia Zawodowego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_2/pkt_4",
       "text": "Departament Prawno-Kontrolny;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_2/pkt_5",
       "text": "Departament Sportu Kwalifikowanego i Młodzieżowego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_2/pkt_6",
