{
 "eli": "MP/2003/386",
 "title": "Zarządzenie Nr 37 Prezesa Rady Ministrów z dnia 26 maja 2003 r. w sprawie nadania statutu Ministerstwu Nauki i Informatyzacji",
 "converter": "eli2md 0.6.22",
