         "path": "par_1/pkt_1/lit_b",
         "text": "nauki;",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "Komitetu Badań Naukowych, działającego na podstawie ustawy z dnia 12 stycznia 1991 r. o Komitecie Badań Naukowych (Dz. U. z 2001 r. Nr 33, poz. 389 oraz z 2003 r. Nr 39, poz. 335).",
