{
 "eli": "MP/2003/454",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 6 marca 2003 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2003/454/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 33/2003 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 6 marca 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "w uznaniu wybitnych zasług dla wymiaru sprawiedliwości, za osiągnięcia w pracy dydaktycznej i naukowej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM Z GWIAZDĄ ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Szymanek Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy dydaktycznej i naukowej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Matey-Tyrowicz Maria,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Czapliński Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi na rzecz edukacji kulturalnej, za osiągnięcia w pracy zawodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Bentkowska-Karpińska Zofia,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz Automobilklubu Krakowskiego, za zaangażowanie w rozwijanie sportów motorowych:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Jaromin Kazimierz Mikołaj, KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Ciastoń Władysław Tomasz, 7. Nidecki Ryszard Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz Automobilklubu Krakowskiego, za zaangażowanie w rozwijanie sportów motorowych:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Dobrzański Jerzy Jan, 9. Jerzykowski Jerzy Andrzej, 10. Schneikart Bogdan,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Klisz Małgorzata Jadwiga, 12. Owczyński Paweł Artur,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności związkowej, za osiągnięcia w pracy zawodowej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Kaczmarek Bogdan Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Krzonkalla Andrzej Marek, 15. Mirski Stanisław, 16. Tyrajski Wojciech Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności związkowej, za osiągnięcia w pracy zawodowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Gorowy Wincenty, 18. Markowski Romuald,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Cendlewski Jan, 20. Ozdoba Mirosława Kazimiera, 21. Pietrzak Ireneusz Tadeusz, 22. Rasiński Janusz Wojciech, 23. Wilk Tadeusz Franciszek, 24. Wnęk Andrzej Jan, 25. Wojtkowiak Romuald Henryk, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Kocot Krzysztof, 27. Kozieł Henryk Franciszek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Machul Lucjan Bogdan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju spółdzielczości mleczarskiej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM"
    },
    {
     "type": "text",
     "text": "ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Kurek Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju spółdzielczości mleczarskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Szulc Czesław Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Szymkowiak Jarosław Józef,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM"
    },
    {
     "type": "text",
     "text": "ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Krzywański Henryk Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM"
    },
    {
     "type": "text",
     "text": "ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Daniłko Józef Dominik, za zasługi w działalności na rzecz społeczności lokalnej:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Ornowski Alojzy,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Iwicki Paweł,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Chmara Alfons, 37. Winowiecki Mirosław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi na rzecz ochrony środowiska naturalnego, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Dolny Joachim Alfons,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Republiki Federalnej Niemiec"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz normalizacji stosunków polsko-niemieckich"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM"
    },
    {
     "type": "text",
     "text": "ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Bender Peter.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
