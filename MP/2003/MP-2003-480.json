{
 "eli": "MP/2003/480",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 18 lutego 2003 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2003/480/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 22/2003"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 lutego 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676), na wniosek Ministra Spraw Zagranicznych, odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "obywatele Rzeczypospolitej Polskiej i Kanady:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności polonijnej:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Siemieński Wilhelm, 2. Wolski André,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Solek Leszek, 4. Wozniak Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w propagowaniu polskiej kultury"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Matejko Joanna, obywatele Kanady",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Winiarski Henryk Marian, 7. Żółkiewicz Janina,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Rzeczypospolitej Polskiej i Republiki Federalnej Niemiec"
    },
    {
     "type": "text",
     "text": "za zasługi w kultywowaniu i propagowaniu polskiej kultury muzycznej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Badura-Schmidt Urszula, 9. Wilkosinski Josef,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Republiki Federalnej Niemiec"
    },
    {
     "type": "text",
     "text": "za zasługi w rozwijaniu polsko-niemieckiej współpracy przygranicznej i regionalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Mildenberger Markus Heinz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
