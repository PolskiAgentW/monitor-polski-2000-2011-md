{
 "eli": "MP/2003/818",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 18 czerwca 2003 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2003/818/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 122/2003"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 czerwca 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r."
  },
  {
   "type": "text",
   "text": "o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju polskiej radiolokacji, za osiągnięcia w pracy naukowo-badawczej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kołosowski Władysław, 2. Łoziński Krzysztof Włodzimierz, 3. Mikoś Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Nowak Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju ruchu ludowego, za osiągnięcia w pracy dziennikarskiej i działalności społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Markowicz Zygmunt Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju rolnictwa i polskiej wsi:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Ditterla Ditrich,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Janusz Józef, 8. Malczewska Teresa,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju rolnictwa i polskiej wsi:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Pierożyńska Małgorzata Emilia, 10. Pluta Alfred Józef, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Hunkiewicz Krzysztof Adam, 12. Urbanowicz Wincenty, 13. Witek Ewa Józefa,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Łyczko Grażyna Krystyna, 15. Rostocka Lilianna,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla gospodarki narodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Klasiński Czesław, 17. Ptaszek Stanisław Marian,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w działalności gospodarczej, za zasługi dla społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Korczak Wiesław Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w działalności gospodarczej, za zasługi dla społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Korczak Irena,",
   "children": [
    {
     "type": "text",
     "text": "za wzorowe, wyjątkowo sumienne wykonywanie obowiązków wynikających z pracy zawodowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Aleksandrowicz Dorota Krystyna, 21. Biazik Waldemar.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
