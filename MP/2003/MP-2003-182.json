       "quoted": true
      },
      {
       "type": "text",
       "text": "21) Departament Kontroli;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "22) Biuro Komunikacji Społecznej;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "23) Biuro Kadr;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "24) Biuro Ochrony Informacji Niejawnych;",
       "quoted": true
      },
      {
       "type": "text",
