{
 "eli": "MP/2003/424",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 18 lutego 2003 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2003/424/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 20/2003 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 lutego 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "text",
   "text": "za zasługi dla rozwoju gospodarki narodowej"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Tobiczyk Janusz Maciej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Cwaliński Jerzy Franciszek, 3. Kośla Euzebiusz Roman, za zasługi w pracy zawodowej",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Richter Andrzej Wacław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności kombatanckiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Kowalik Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności charytatywnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Smorawińska Elżbieta Irena.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
