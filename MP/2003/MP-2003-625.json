{
 "eli": "MP/2003/625",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 29 kwietnia 2003 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2003/625/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 72/2003"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 29 kwietnia 2003 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. (Dz. U. Nr 78, poz. 483) oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718 oraz z 2002 r. Nr 74, poz. 676) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz rozwoju przemysłu mleczarskiego"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Akus Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju przemysłu mleczarskiego"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Kaoka Edward,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla społeczności lokalnej, za osiągnięcia w działalności gospodarczej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Gliwa Tomasz Teodor,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla ochrony środowiska naturalnego, za działalność społeczną:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Dobiesz Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Siejkowski Leszek Ignacy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla ochrony środowiska naturalnego, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Grzywacz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Grzanka Lucjan, 8. Kamiński Henryk, za wybitne zasługi w działalności na rzecz krzewienia kultury fizycznej i sportu",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Piętka Zdzisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej w Towarzystwie Miłośników Regionu „Macierz Ziemi Cieszyńskiej”, za osiągnięcia w pracy zawodowej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Klajsek Józef, 11. Sosna Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej w Towarzystwie Miłośników Regionu „Macierz Ziemi Cieszyńskiej”, za osiągnięcia w pracy zawodowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Makowski Mariusz Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Szelong Krzysztof Dariusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności gospodarczej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Kot Wojciech, 15. Łuczko-Staszków Anna, 16. Prawda Roman,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności gospodarczej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Kot Piotr Krzysztof, 18. Prawda Anna,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla społeczności lokalnej, za działalność społeczną"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Konopka Alicja, 20. Matuszewski Ryszard, za zasługi w działalności społecznej na rzecz honorowego krwiodawstwa:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Liszniański Włodzimierz, 22. Posański Jerzy, 23. Słodkowski Henryk,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Kluczberg Stefan, 25. Przygocki Władysław, 26. Traskowski Henryk,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Perszon Roman, 28. Trzaskalski Bronisław, za zasługi w działalności na rzecz osób niepełnosprawnych:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Białek Ryszard, 30. Sulewska Zofia Kazimiera,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Głowienka Roman Józef, 32. Pisarska Maria Wiesława.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Kwaśniewski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
