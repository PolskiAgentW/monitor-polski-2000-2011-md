    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Stuglik Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Drobny Józef, 31. Maciaszek Krzysztof, 32. Nowak Stanisław, za zasługi w działalności na rzecz społeczności lokalnej",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
