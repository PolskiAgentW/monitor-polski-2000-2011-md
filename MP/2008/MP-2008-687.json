     "type": "text",
     "text": "za zasługi w działalności na rzecz krzewienia kultury w środowiskach wiejskich"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Bielecka Barbara,",
   "children": [
    {
     "type": "text",
