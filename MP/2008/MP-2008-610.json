 "title": "Zarządzenie Nr 100 Prezesa Rady Ministrów z dnia 9 września 2008 r. w sprawie nadania statutu Ministerstwu Gospodarki",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2008/610/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 100 PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 9 września 2008 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Gospodarki"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Gospodarki nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 122 Prezesa Rady Ministrów z dnia 6 listopada 2007 r. w sprawie nadania statutu Ministerstwu Gospodarki (M. P. Nr 82, poz. 873).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
