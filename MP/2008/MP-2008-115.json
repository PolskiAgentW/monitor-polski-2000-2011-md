 "title": "Obwieszczenie Ministra Gospodarki z dnia 22 stycznia 2008 r. w sprawie wykazu gmin górniczych",
 "converter": "eli2md 0.6.22",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2008/115/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "OBWIESZCZENIE MINISTRA GOSPODARKI[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 22 stycznia 2008 r."
  },
  {
   "type": "text",
   "text": "w sprawie wykazu gmin górniczych"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 3 ustawy z dnia 7 września 2007 r. o funkcjonowaniu górnictwa węgla kamiennego w latach 2008—2015 (Dz. U. Nr 192, poz. 1379) ogłasza się wykaz gmin górniczych, stanowiący załącznik do obwieszczenia."
  },
  {
   "type": "signature",
   "text": "Minister Gospodarki: W. Pawlak"
  }
 ],
