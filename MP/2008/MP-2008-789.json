     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_4/pkt_4",
     "text": "Departament Leśnictwa;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_4/pkt_5",
     "text": "Departament Ochrony Przyrody;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_4/pkt_6",
