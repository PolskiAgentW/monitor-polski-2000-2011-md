   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Obsługę zadań Ministra w zakresie działu gospodarka wodna zapewnia w szczególności Departament Instrumentów Środowiskowych.",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Obsługę zadań Ministra w zakresie działu środowisko zapewniają w szczególności:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
