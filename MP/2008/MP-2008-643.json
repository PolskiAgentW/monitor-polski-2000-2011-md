 "body": [
  {
   "type": "text",
   "text": "Rej. 25/2008"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 29 lutego 2008 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718, z 2002 r. Nr 74, poz. 676, z 2006 r. Nr 104, poz. 708 i 711 i Nr 194, poz. 1432 oraz z 2007 r. Nr 25, poz. 162 i Nr 123, poz. 848) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju turystyki"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Rukat Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Rolnictwa i Rozwoju Wsi"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju rolnictwa:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Gromek Zygmunt Tadeusz, 3. Gwiazda Grzegorz, 4. Pędziwiatr Wiesław Henryk,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Adamczewski Waldemar,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Cadler Edward,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Bagiński Czesław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Jaroszuk Józef, 9. Maruszewski Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Poniatowski Henryk, 11. Wójcik Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Florczak Wojciech, 13. Krumholc Mieczysław Henryk,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Bogdziewicz Grzegorz Michał, 15. Cybula Gerard, 16. Czerniak Krzysztof Tadeusz, 17. Jarosławski Mariusz Radosław, 18. Jastrzębski Mirosław Henryk, 19. Rybczyński Paweł Jan, 20. Sielatycka Barbara Ewa,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz Stowarzyszenia Rodzin Katyńskich"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Dylewska Irena Maria, 22. Zarzycka Ewa,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Czopiński Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Bewicz Roman, 25. Targacz Albert Wincenty,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Tuliszewska Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI po raz drugi"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Fedorowicz Aleksander,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Obrony Narodowej"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "por. Gruszfeld Wiesław Wojciech, 29. st. kpr. Kukieła Piotr Dariusz, 30. st. szer. Matejko Radosław Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Dąbrowski Krzysztof, 32. Dziemidok Mieczysław, 33. st. post. Gogola Piotr, 34. st. post. Szyszka Piotr, 35. Zamecki Mateusz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: L. Kaczyński"
  }
 ],
