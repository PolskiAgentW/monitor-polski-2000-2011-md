  },
  {
   "type": "text",
   "text": "— Eugeniusza GRZESZCZAKA"
  },
  {
   "type": "text",
   "text": "— Marka KUCHCIŃSKIEGO"
  },
  {
   "type": "text",
   "text": "— Jerzego WENDERLICHA"
  },
  {
   "type": "text",
   "text": "na stanowiska wicemarszałków Sejmu."
  },
  {
